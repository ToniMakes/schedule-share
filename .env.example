# Copy this file to .env.local for local development, or set the same keys in
# your hosting provider. Never commit real production secrets.

# Required by the web app, db:check, smoke:api and verify:deployment. Local
# Docker defaults are defined in compose.yaml.
DATABASE_URL=postgres://schedule_share:schedule_share@localhost:5432/schedule_share

# Optional direct Postgres URL for schema migrations. Use this with Neon when
# DATABASE_URL points to a pooled endpoint whose hostname contains "-pooler".
DATABASE_MIGRATION_URL=

# Optional canonical app URL used when generating share, owner and edit links.
# Leave empty locally to infer the URL from the incoming request.
APP_BASE_URL=

# Optional public support inbox shown on /contact and /feedback. This value is public; do
# not use a private inbox that should not be displayed to visitors.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Required in Vercel Production/Preview once cron jobs are configured. Vercel
# sends it as Authorization: Bearer <CRON_SECRET> when invoking cron routes.
CRON_SECRET=

# Optional schedule cleanup policy. Expired open/locked schedules are archived;
# archived schedules are hard-deleted after the grace period.
SCHEDULE_HARD_DELETE_GRACE_DAYS=30
SCHEDULE_CLEANUP_BATCH_SIZE=100

# Optional credential for image timetable/shift import previews. This key alone
# does not enable the feature; the feature gates below must also allow it.
OPENAI_API_KEY=

# Optional model override for image import recognition.
OPENAI_IMAGE_IMPORT_MODEL=gpt-5.6-luna

# Image import is closed by default. Keep it closed in Production until the
# credit ledger, rewarded ad verification, and cost guardrails are implemented.
AI_IMAGE_IMPORT_ENABLED=false
AI_IMAGE_IMPORT_RELEASE_MODE=off
AI_IMAGE_IMPORT_INTERNAL_TEST_TOKEN=
AI_IMAGE_IMPORT_MAX_BYTES=4194304
AI_IMAGE_IMPORT_ESTIMATED_COST_USD=0.01
AI_IMAGE_IMPORT_MAX_ESTIMATED_COST_USD=0.02
AI_IMAGE_IMPORT_DAILY_REQUEST_LIMIT=20
AI_IMAGE_IMPORT_DAILY_COST_LIMIT_USD=0.25
OPENAI_IMAGE_IMPORT_TIMEOUT_MS=15000
OPENAI_IMAGE_IMPORT_MAX_OUTPUT_TOKENS=2000
OPENAI_IMAGE_IMPORT_MIN_CONFIDENCE=0.6
AI_IMAGE_AD_GATE_READY=false
AI_IMAGE_CREDITS_ENFORCED=false
AI_IMAGE_COST_GUARDRAIL_ENABLED=false

# Display ads are also closed by default. Set PREVIEW and PLACEHOLDERS locally
# to inspect layout without loading a third-party ad script.
NEXT_PUBLIC_DISPLAY_ADS_ENABLED=false
NEXT_PUBLIC_DISPLAY_ADS_PREVIEW=false
NEXT_PUBLIC_DISPLAY_ADS_PROVIDER=placeholder
NEXT_PUBLIC_DISPLAY_ADS_PLACEHOLDERS=false
NEXT_PUBLIC_DISPLAY_ADS_KEYED_URL_MODE=internal
NEXT_PUBLIC_DISPLAY_ADS_ALLOWED_HOSTS=schedule.tonimakes.com
NEXT_PUBLIC_DISPLAY_ADS_TEST_MODE=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_TOP_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_INLINE_RESULTS=
NEXT_PUBLIC_ADSENSE_SLOT_POST_SUBMIT=
NEXT_PUBLIC_ADSENSE_SLOT_DESKTOP_RAIL=
NEXT_PUBLIC_ADSENSE_SLOT_MOBILE_ANCHOR=
ADS_TXT_PUBLISHER_ID=
ADS_PRIVACY_DISCLOSURE_READY=false
ADS_POLICY_REVIEW_READY=false
ADS_CONSENT_STRATEGY_READY=false

# Used by smoke:api and verify:deployment. Keep this as localhost for local
# checks, and override it with the deployed site URL for production checks.
SMOKE_BASE_URL=http://127.0.0.1:3000
