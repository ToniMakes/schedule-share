{
  "name": "schedule-share",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "corepack pnpm -r build",
    "db:check": "corepack pnpm --filter @schedule-share/db db:check",
    "db:down": "docker compose down",
    "db:migrate": "corepack pnpm --filter @schedule-share/db db:migrate",
    "db:migrate:local": "node scripts/run-with-local-db.mjs corepack pnpm --filter @schedule-share/db db:migrate",
    "db:setup": "node scripts/setup-database.mjs",
    "db:up": "docker compose up -d postgres",
    "deployment:config": "node scripts/check-deployment-config.mjs",
    "dev": "corepack pnpm --filter @schedule-share/web dev",
    "dev:local": "node scripts/run-with-local-db.mjs corepack pnpm --filter @schedule-share/web dev",
    "env:init": "node scripts/init-env.mjs",
    "env:status": "node scripts/env-status.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "corepack pnpm lint:scripts && corepack pnpm -r lint",
    "lint:scripts": "eslint \"scripts/*.mjs\"",
    "smoke:api": "node scripts/smoke-api.mjs",
    "test": "corepack pnpm test:scripts && corepack pnpm -r test",
    "test:scripts": "node --test scripts/config-checks.test.mjs",
    "typecheck": "corepack pnpm -r typecheck",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@next/eslint-plugin-next": "15.5.21",
    "@types/node": "^26.1.1",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
