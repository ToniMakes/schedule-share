# Public API endpoint; use the deployed schedule-share URL or your computer's LAN IP for device testing.
EXPO_PUBLIC_API_BASE_URL=https://schedule.tonimakes.com

# Optional Firebase Web app config. Leave blank to use local profile and room-list storage.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
